rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // flowsense_users collection: allow authenticated users to read
    match /flowsense_users/{userId} {
      // Allow any authenticated user to read users list
      // (you may want to restrict this to admins only by checking auth.token.admin custom claim)
      allow read: if request.auth != null;
      
      // Only allow admin users to write
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Allow reads from admin panel (fallback for static deployments)
    match /flowsense_users {
      allow read: if request.auth != null;
    }
  }
}
