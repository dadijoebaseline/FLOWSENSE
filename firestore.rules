rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // flowsense_users collection: secure admin-only access with custom claims
    match /flowsense_users/{userId} {
      // Only allow authenticated users with admin custom claim to read/write
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.token.admin == true;
      
      // Fallback: allow read during first setup if no custom claims yet
      // Remove this after initial setup for better security
      allow read: if request.auth != null && request.auth.token.admin == null && 
                     get(/databases/$(database)/documents/flowsense_users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow admin collection reads (for querying all users)
    match /flowsense_users {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
