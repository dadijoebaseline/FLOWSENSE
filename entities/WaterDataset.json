{
  "name": "WaterDataset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name/label for this dataset upload"
    },
    "monthLabel": {
      "type": "string",
      "description": "Month label e.g. 2024-01, 2024-02"
    },
    "fileUrl": {
      "type": "string",
      "description": "URL of the uploaded GeoJSON file"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "processing",
        "completed",
        "error"
      ],
      "default": "uploaded",
      "description": "Processing status"
    },
    "totalAccounts": {
      "type": "number",
      "default": 0,
      "description": "Total accounts in this dataset"
    },
    "anomaliesFound": {
      "type": "number",
      "default": 0,
      "description": "Number of anomalies detected"
    }
  },
  "required": [
    "name",
    "monthLabel"
  ]
}