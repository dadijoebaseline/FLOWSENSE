{
  "name": "Anomaly",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "description": "Reference to WaterAccount accountId"
    },
    "accountName": {
      "type": "string",
      "description": "Account holder name"
    },
    "address": {
      "type": "string",
      "description": "Account address"
    },
    "anomalyType": {
      "type": "string",
      "enum": [
        "sudden_high",
        "zero_consumption",
        "sudden_down"
      ],
      "description": "Type of anomaly detected"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Severity level"
    },
    "averageConsumption": {
      "type": "number",
      "description": "Average consumption over prior months (cu.m.)"
    },
    "currentConsumption": {
      "type": "number",
      "description": "Current month consumption (cu.m.)"
    },
    "deviationPercent": {
      "type": "number",
      "description": "Percentage deviation from average"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate"
    },
    "datasetId": {
      "type": "string",
      "description": "Reference to the parent WaterDataset"
    },
    "monthLabel": {
      "type": "string",
      "description": "Month when anomaly was detected"
    }
  },
  "required": [
    "accountId",
    "anomalyType"
  ]
}